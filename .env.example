# Optional: fixed workspace folder (default = current directory)
# AGENT_WORKSPACE=/path/to/your/project

# Extra allowed roots (colon-separated). Primary workspace stays untouched.
# Example for Termux internal storage:
# AGENT_EXTRA_ROOTS=/sdcard/Download:/sdcard/DCIM:/sdcard/Documents:/sdcard/Pictures
# AGENT_EXTRA_ROOTS=/sdcard/Download

# --- MCP server security (HTTP mode) ---
# REQUIRED: server refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Client sends  Authorization: Bearer <token>   OR   https://host/mcp?token=<token>
AGENT_API_TOKEN=
# Powerful tools are OFF by default. Enable only if you need them:
# ENABLE_SHELL=1      (run_command + run_tests)
# ENABLE_DELETE=1     (delete_path)
# Escape hatch (NOT recommended): run HTTP mode without auth
# ALLOW_UNAUTHENTICATED=1

# --- Shell policy (applies whenever run_command / run_tests is used) ---
# Comma-separated command names allowed. python/pytest can execute arbitrary code:
# remove them if you do not want that (run_tests then stops working).
# SHELL_ALLOWLIST=ls,cat,head,tail,wc,grep,find,pwd,echo,diff,git,pytest,python,python3
# GIT_ALLOWED_SUBCOMMANDS=status,diff,log,show,branch,rev-parse,add,commit,restore,checkout,stash
# Old behaviour (shell=True, any command, pipes/redirects allowed). NOT recommended:
# SHELL_UNRESTRICTED=1

# --- Verification loop (edit -> test -> fix) ---
# Base command for run_tests (still must pass the allowlist):
# TEST_COMMAND=pytest -q --tb=short
# Local agent: before accepting a final answer after file changes, ask the model
# to run tests first (nudges are capped per user message).
# AUTO_VERIFY=1
# VERIFY_MAX_NUDGES=2

# --- Local agent only ---
# REQUIRE_CONFIRMATION=true
# REQUIRE_CONFIRMATION_REMOTE=false

# --- Local Grok agent only ---
# Get a key at https://console.x.ai
# XAI_API_KEY=your_xai_api_key_here
# GROK_MODEL=grok-4.5
# GROK_BASE_URL=https://api.x.ai/v1

# --- Limits / audit ---
# MAX_STEPS=12
# AUDIT_LOG_PATH=.agent_audit.jsonl
