# --- Workspace / persistence ---
# AGENT_WORKSPACE=/app/workspace
# AGENT_DB_PATH=/app/workspace/.shellsage.sqlite3

# --- MCP server security ---
# REQUIRED in HTTP mode.
AGENT_API_TOKEN=
# Optional powerful tools; keep disabled unless needed.
# ENABLE_SHELL=1
# ENABLE_DELETE=1
# ALLOW_UNAUTHENTICATED=0

# --- Shell policy ---
# SHELL_ALLOWLIST=ls,cat,head,tail,wc,grep,find,pwd,echo,diff,git,pytest,python,python3
# GIT_ALLOWED_SUBCOMMANDS=status,diff,log,show,branch,rev-parse,add,commit,restore,checkout,stash
# SHELL_UNRESTRICTED should remain unset in production.

# --- Verification ---
# TEST_COMMAND=pytest -q --tb=short
# AUTO_VERIFY=1
# VERIFY_MAX_NUDGES=2

# --- Grok ---
# XAI_API_KEY=
# GROK_MODEL=grok-4.5
# GROK_BASE_URL=https://api.x.ai/v1
